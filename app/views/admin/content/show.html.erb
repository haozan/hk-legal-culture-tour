<% content_for :title, '錄題後臺' %>
<% paper_label = case @paper_name
                 when ContentSnapshot::PAPER_TWO_NAME then '卷二'
                 when ContentSnapshot::PAPER_THREE_NAME then '卷三'
                 else '卷一'
                 end %>
<% content_for :head do %>
  <%= stylesheet_link_tag 'content_admin', media: 'all' %>
<% end %>

<div class="content-admin" data-save-url="<%= save_admin_content_path(paper: @paper_name) %>" data-paper-name="<%= @paper_name %>" data-available-papers="<%= [ContentSnapshot::PAPER_NAME, ContentSnapshot::PAPER_TWO_NAME, ContentSnapshot::PAPER_THREE_NAME].join('|') %>">
  <header class="topbar">
    <div class="brand-lockup">
      <div class="brand-mark">象</div>
      <div>
        <div class="eyebrow">CONTENT STUDIO</div>
        <h1>港險小象 <span>錄題後臺</span></h1>
      </div>
    </div>
    <div class="top-actions">
      <span class="save-status" id="saveStatus">伺服器草稿 · 已儲存</span>
      <button class="button ghost" id="importButton" type="button">匯入快照</button>
      <button class="button primary" id="exportButton" type="button">匯出快照</button>
      <%= button_to '退出', admin_logout_path, method: :delete, class: 'button ghost' %>
      <input id="importInput" name="file" form="importForm" type="file" accept="application/json,.json" hidden />
    </div>
  </header>

  <div class="workspace">
    <aside class="sidebar">
      <div class="side-heading">
        <div>
          <div class="eyebrow">PAPERS</div>
          <h2>試卷</h2>
        </div>
        <span class="count-badge">5</span>
      </div>
      <nav class="paper-list" id="paperList"></nav>
      <div class="side-footer">
        <div class="sync-card">
          <div class="sync-icon">↗</div>
          <div>
            <strong>伺服器同步</strong>
            <p>儲存後寫入香港伺服器，App 後續可讀取同一份快照。</p>
          </div>
        </div>
      </div>
    </aside>

    <main class="main-content">
      <section class="page-head">
        <div>
      <div class="eyebrow"><%= paper_label %> · 內容維護</div>
          <h2>大綱與題目</h2>
          <p>先維護章節樹，再把題目掛到對應的參考章節。</p>
        </div>
        <div class="head-metrics" id="headMetrics"></div>
      </section>

      <div class="content-grid">
        <section class="panel outline-panel">
          <div class="panel-head">
            <div>
              <h3><%= paper_label %>大綱</h3>
              <p>點選節點編輯；右鍵節點可新建、關聯試題或刪除大綱。</p>
            </div>
            <div class="panel-actions">
              <button class="button small" id="addChapterButton" type="button">＋ 新章節</button>
            </div>
          </div>
          <div class="outline-toolbar">
            <label class="search-box">
              <span>⌕</span>
              <input id="outlineSearch" type="search" placeholder="搜尋編號或標題" />
            </label>
            <button class="text-button" id="collapseAllButton" type="button">全部收起</button>
          </div>
          <div class="outline-tree" id="outlineTree"></div>
        </section>

        <section class="panel editor-panel">
          <div class="panel-head editor-head">
            <div>
              <div class="eyebrow" id="selectionEyebrow">選擇一個大綱節點</div>
              <h3 id="selectionTitle">開始錄入內容</h3>
              <p id="selectionHint">從左側選擇章節或小節。</p>
            </div>
            <button class="button small primary" id="newQuestionButton" type="button" disabled>＋ 新題目</button>
          </div>
          <div id="editorContent" class="editor-content empty-state">
            <div class="empty-illustration">✦</div>
            <h3>從大綱開始</h3>
            <p>選擇一個章節或小節，維護標題、比重與題目。</p>
          </div>
        </section>
      </div>
    </main>
  </div>
</div>

<%= form_with url: import_admin_content_path, method: :post, id: 'importForm', multipart: true, class: 'hidden', data: { turbo: false } do %>
  <%= hidden_field_tag :_import_marker, '1' %>
<% end %>

<div class="toast" id="toast" role="status"></div>
<div class="outline-context-menu" id="outlineContextMenu" hidden role="menu" aria-label="大綱操作">
  <div class="context-menu-title" id="contextMenuTitle">大綱節點</div>
  <button type="button" data-action="new-child">＋ 新建下級大綱</button>
  <button type="button" data-action="new-question">＋ 新建試題</button>
  <button type="button" data-action="link-question">↗ 關聯已有試題</button>
  <div class="context-menu-divider"></div>
  <button type="button" class="danger" data-action="delete-node">⌫ 刪除節點</button>
</div>
<script type="application/json" id="gangxian-content-data"><%= raw json_escape(@data.to_json) %></script>
<%= javascript_include_tag 'content_admin', type: 'module' %>
